# ===========================================================================
# Agent 平台 —— 环境变量示例
#
# 使用方式：
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# 然后按需修改。**所有项都有默认值，只有想启用 DeepSeek 时才必须填 Key**。
# 不填 Key 时平台进入离线模式：检索、拒答、路由、评测全部可用，
# 仅回答生成改为模板拼接（/health 会显示 llm.online=false）。
# ===========================================================================

# ============================== LLM ==============================
# 提供商：deepseek（默认）| dashscope（阿里云百炼，OpenAI 兼容）
LLM_PROVIDER=deepseek
# 运行模式：auto（有 Key 就联网）| online（强制联网）| offline（强制离线，CI 用）
LLM_MODE=auto

# --- DeepSeek 官方 ---
DEEPSEEK_API_KEY=your_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# --- 阿里云百炼（把 LLM_PROVIDER 改成 dashscope 后生效；模型名需换成百炼上真实存在的）---
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# ============================ Embedding ============================
# 本地 Embedding 模型（首次运行会自动下载，约 100MB）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
# bge 系列检索侧查询前缀（清空可用于评测对比，验证前缀带来的召回提升）
EMBEDDING_QUERY_PREFIX=为这个句子生成表示以用于检索相关文章：
# auto：优先用 sentence-transformers，加载失败自动降级为 hash（无模型也能跑通全链路）
EMBEDDING_BACKEND=auto
EMBEDDING_CACHE_DIR=./data/models

# ============================== 检索 ==============================
RETRIEVE_TOP_K=3
RETRIEVE_CANDIDATES=20
ENABLE_BM25=true
# 打开需要下载 bge-reranker-base（约 1GB）
ENABLE_RERANK=false
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_TOP_N=10
RRF_K=60
# 拒答阈值：融合分数低于该值直接短路返回标准话术（不调用大模型）
REFUSE_THRESHOLD=0.35
ENABLE_CITATION_CHECK=true
RETRIEVE_CACHE_SIZE=200

# =========================== 文档处理 ===========================
CHUNK_SIZE=500
CHUNK_OVERLAP=50
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=50
ALLOWED_EXTENSIONS=.pdf,.docx,.txt,.md
CHROMA_DIR=./chroma_db
COLLECTION_NAME=knowledge_base

# ============================== Agent ==============================
AGENT_MAX_STEPS=4
AGENT_MAX_CONTEXT_CHARS=8000
AGENT_HISTORY_TURNS=6
ENABLE_QUERY_REWRITE=true
AGENT_STREAM=true

# =============================== Web ===============================
HOST=127.0.0.1
PORT=8000
UI_MOUNT_PATH=/ui
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============================== 存储 ==============================
DB_PATH=./data/agent_platform.db
LOG_LEVEL=INFO
LOG_JSON=false
TRACE_ENABLED=true
